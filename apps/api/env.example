# Copy to apps/api/env locally. Never commit real secrets.
SECRET_KEY=
DATABASE_URL=
MAILGUN_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
# PIN brute-force lockout
PIN_LOCK_THRESHOLD=5
PIN_LOCK_MINUTES=15
# Auto-deactivate accounts inactive 60+ days (log-only unless true)
AUTO_DEACTIVATE=false

# Receipt OCR. The cloud provider is tried first, the LAN vision model is the fallback so
# a powered-off LAN box does not break scanning.
# OCR_LOCAL_API_KEY / OCR_LOCAL_BASE_URL default to ILMU_API_KEY / ILMU_BASE_URL.
OCR_LOCAL_MODEL=chatbot-v1
OCR_OPENAI_API_KEY=
OCR_OPENAI_BASE_URL=https://api.openai.com/v1
OCR_OPENAI_MODEL=gpt-4.1-mini

# Log hygiene. Message text is kept out of the logs unless LOG_MESSAGE_CONTENT=1 is set;
# turn it on only while diagnosing a specific report, then remove it. access_logs rows
# older than ACCESS_LOG_RETENTION_DAYS are purged every 6 hours.
LOG_MESSAGE_CONTENT=
ACCESS_LOG_RETENTION_DAYS=30
